page {
  background: linear-gradient(135deg, #fff5f8 0%, #fff0f5 50%, #fff5f8 100%);
}

.container {
  min-height: 100vh;
  position: relative;
  padding-bottom: 180rpx;
}

.hero {
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: center;
}

.hero-content {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 8rpx 30rpx rgba(255, 158, 207, 0.25);
  border: 2rpx solid #ffd4e5;
}

.hero-emoji {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #d4a5ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  color: #aaa;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  overflow-x: auto;
}

.filter-bar-item {
  padding: 18rpx 36rpx;
  border: 2rpx solid #ffd4e5;
  background: white;
  color: #888;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.filter-bar-item.active {
  background: linear-gradient(135deg, #ff9ecf, #d4a5ff);
  color: white;
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(255, 158, 207, 0.35);
}

.posts-section {
  padding: 0 30rpx;
}

.stats-section {
  padding: 50rpx 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b9d;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.title-paw {
  font-size: 40rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.spinner {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid #ffd4e5;
  border-top-color: #ff9ecf;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  margin-bottom: 15rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #aaa;
}

.posts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25rpx;
}

.post-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  border: 2rpx solid #ffd4e5;
}

.delete-btn {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #ef4444;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
  border: 2rpx solid #ffd4e5;
}

.post-media {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #ffe8ef, #ffeaa5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  overflow: hidden;
}

.post-image,
.post-video {
  width: 100%;
  height: 100%;
}

.post-emoji {
  font-size: 90rpx;
}

.post-content {
  padding: 25rpx;
}

.post-type-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.type-photo {
  background: linear-gradient(135deg, #ffecd2, #fcb69f);
  color: #d35400;
}

.type-video {
  background: linear-gradient(135deg, #a8edea, #fed6e3);
  color: #007788;
}

.type-text {
  background: linear-gradient(135deg, #e0c3fc, #8ec5fc);
  color: #6b21a8;
}

.post-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-text {
  color: #888;
  font-size: 24rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 15rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #aaa;
  font-size: 22rpx;
}

.post-date {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.post-likes {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  background: white;
  border-radius: 20rpx;
  padding: 45rpx 30rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #ffd4e5;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #ff9ecf, #d4a5ff, #a5d4ff);
}

.stat-icon {
  display: block;
  font-size: 55rpx;
  margin-bottom: 12rpx;
}

.stat-number {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ff6b9d;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  color: #888;
  font-size: 24rpx;
  font-weight: 500;
}

.add-post-btn {
  position: fixed;
  bottom: 50rpx;
  right: 30rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9ecf, #ff6b9d);
  border: none;
  color: white;
  font-size: 60rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 158, 207, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.modal-content {
  background: white;
  border-radius: 28rpx 28rpx 0 0;
  padding: 45rpx 30rpx;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 35rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #ffd4e5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ff6b9d;
}

.close-btn {
  background: #ffe8ef;
  border: none;
  color: #888;
  font-size: 52rpx;
  width: 65rpx;
  height: 65rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.form-group {
  margin-bottom: 35rpx;
}

.form-label {
  display: block;
  margin-bottom: 15rpx;
  color: #333;
  font-weight: 500;
  font-size: 28rpx;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  padding: 28rpx;
  border: 2rpx solid #ffd4e5;
  background: white;
  color: #333;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 220rpx;
  line-height: 1.6;
}

.file-upload {
  border: 3rpx dashed #ffd4e5;
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
  background: #fff5f8;
}

.file-upload-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.file-upload-text {
  color: #888;
  font-size: 26rpx;
}

.preview-container {
  position: relative;
  margin-top: 25rpx;
}

.preview-image,
.preview-video {
  width: 100%;
  max-height: 450rpx;
  border-radius: 16rpx;
  border: 3rpx solid #ffd4e5;
}

.remove-media {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background: #ff4d4f;
  color: white;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.submit-btn {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, #ff9ecf, #ff6b9d);
  border: none;
  border-radius: 16rpx;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 15rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.post-view {
  max-width: 100%;
}

.post-view-date {
  color: #888;
  margin-bottom: 25rpx;
  font-size: 26rpx;
}

.post-media-large {
  width: 100%;
  max-height: 650rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #ffe8ef, #ffeaa5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  overflow: hidden;
}

.post-image-large,
.post-video-large {
  width: 100%;
  max-height: 650rpx;
}

.post-emoji-large {
  font-size: 140rpx;
}

.post-full-text {
  line-height: 1.8;
  font-size: 30rpx;
  white-space: pre-wrap;
  color: #333;
}

.post-view-likes {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #ffd4e5;
  color: #ff6b9d;
  font-weight: 600;
  font-size: 28rpx;
}
