page {
  background: linear-gradient(135deg, #fff5f8 0%, #fff0f5 50%, #fff5f8 100%);
}

.container {
  min-height: 100vh;
  position: relative;
}

.hero {
  padding: 60rpx 40rpx;
  display: flex;
  justify-content: center;
}

.hero-content {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 30px;
  padding: 60rpx 40rpx;
  border: 3px solid #ffd4e5;
  box-shadow: 0 20px 60px rgba(255, 158, 207, 0.3);
  text-align: center;
  max-width: 700rpx;
}

.hero-emoji {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20px); }
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #d4a5ff 50%, #a5d4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  display: block;
  font-size: 32rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  color: #aaa;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
  flex-wrap: wrap;
}

.filter-btn {
  padding: 20rpx 40rpx;
  border: 2px solid #ffd4e5;
  background: white;
  color: #888;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.filter-btn.active {
  background: linear-gradient(135deg, #ff9ecf, #d4a5ff);
  color: white;
  border-color: transparent;
  box-shadow: 0 5px 20px rgba(255, 158, 207, 0.3);
}

.posts-section {
  padding: 0 40rpx;
}

.stats-section {
  padding: 60rpx 40rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b9d;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.title-paw {
  font-size: 48rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #888;
}

.spinner {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  border: 4px solid #ffd4e5;
  border-top-color: #ff9ecf;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #888;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  margin-bottom: 15rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #aaa;
}

.posts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.post-card {
  background: white;
  border: 3px solid #ffd4e5;
  border-radius: 25px;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  position: relative;
}

.delete-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 2px solid #ffd4e5;
  color: #ef4444;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

.post-media {
  width: 100%;
  height: 350rpx;
  background: linear-gradient(135deg, #ffe8ef, #ffeaa5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  overflow: hidden;
}

.post-image,
.post-video {
  width: 100%;
  height: 100%;
}

.post-emoji {
  font-size: 100rpx;
}

.post-content {
  padding: 30rpx;
}

.post-type-badge {
  display: inline-block;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.type-photo {
  background: linear-gradient(135deg, #ffecd2, #fcb69f);
  color: #d35400;
}

.type-video {
  background: linear-gradient(135deg, #a8edea, #fed6e3);
  color: #007788;
}

.type-text {
  background: linear-gradient(135deg, #e0c3fc, #8ec5fc);
  color: #6b21a8;
}

.post-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #4a4a4a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-text {
  color: #888;
  font-size: 26rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  margin-bottom: 20rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #aaa;
  font-size: 24rpx;
}

.post-date {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.post-likes {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.stat-card {
  background: white;
  border: 3px solid #ffd4e5;
  border-radius: 25px;
  padding: 50rpx 30rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #ff9ecf, #d4a5ff, #a5d4ff);
}

.stat-icon {
  display: block;
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b9d;
  margin-bottom: 10rpx;
}

.stat-label {
  display: block;
  color: #888;
  font-size: 26rpx;
  font-weight: 500;
}

.add-post-btn {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9ecf, #ff6b9d);
  border: none;
  color: white;
  font-size: 60rpx;
  box-shadow: 0 10px 30px rgba(255, 158, 207, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  background: white;
  border: 3px solid #ffd4e5;
  border-radius: 30px;
  padding: 50rpx;
  width: 100%;
  max-width: 700rpx;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b9d;
}

.close-btn {
  background: #ffe8ef;
  border: none;
  color: #888;
  font-size: 60rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  margin-bottom: 20rpx;
  color: #4a4a4a;
  font-weight: 600;
  font-size: 28rpx;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  padding: 25rpx;
  border: 2px solid #ffd4e5;
  background: #fff5f8;
  color: #4a4a4a;
  border-radius: 15px;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 300rpx;
  line-height: 1.6;
}

.file-upload {
  border: 3px dashed #ffd4e5;
  border-radius: 20px;
  padding: 60rpx;
  text-align: center;
  background: #fff5f8;
}

.file-upload-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.file-upload-text {
  color: #888;
  font-size: 28rpx;
}

.preview-container {
  position: relative;
  margin-top: 30rpx;
}

.preview-image,
.preview-video {
  width: 100%;
  max-height: 500rpx;
  border-radius: 15px;
  border: 3px solid #ffd4e5;
}

.remove-media {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ff4d4f;
  color: white;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.submit-btn {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #ff9ecf, #ff6b9d);
  border: none;
  border-radius: 15px;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.post-view {
  max-width: 800rpx;
}

.post-view-date {
  color: #888;
  margin-bottom: 30rpx;
  font-size: 26rpx;
}

.post-media-large {
  width: 100%;
  max-height: 700rpx;
  border-radius: 20px;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #ffe8ef, #ffeaa5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 150rpx;
  overflow: hidden;
}

.post-image-large,
.post-video-large {
  width: 100%;
  max-height: 700rpx;
}

.post-emoji-large {
  font-size: 150rpx;
}

.post-full-text {
  line-height: 1.8;
  font-size: 30rpx;
  white-space: pre-wrap;
  color: #4a4a4a;
}

.post-view-likes {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2px solid #ffd4e5;
  color: #ff6b9d;
  font-weight: bold;
  font-size: 28rpx;
}
