page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  position: relative;
  padding-bottom: 180rpx;
}

.hero {
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: center;
}

.hero-content {
  background: white;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.hero-emoji {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #07c160;
}

.hero-subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.filter-bar {
  display: flex;
  gap: 15rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
}

.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-btn {
  padding: 15rpx 30rpx;
  border: none;
  background: white;
  color: #666;
  border-radius: 50rpx;
  font-size: 26rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-btn.active {
  background: #07c160;
  color: white;
}

.posts-section {
  padding: 0 30rpx;
}

.stats-section {
  padding: 40rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.title-paw {
  font-size: 36rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.spinner {
  display: inline-block;
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.posts-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.delete-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.post-media {
  width: 100%;
  height: 400rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  overflow: hidden;
}

.post-image,
.post-video {
  width: 100%;
  height: 100%;
}

.post-emoji {
  font-size: 80rpx;
}

.post-content {
  padding: 25rpx;
}

.post-type-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 15rpx;
  background: #f0f0f0;
  color: #666;
}

.type-photo {
  background: #e6f7ff;
  color: #1890ff;
}

.type-video {
  background: #f6ffed;
  color: #52c41a;
}

.type-text {
  background: #f9f0ff;
  color: #722ed1;
}

.post-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #333;
  line-height: 1.4;
}

.post-text {
  color: #666;
  font-size: 26rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 15rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #999;
  font-size: 24rpx;
}

.post-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.post-likes {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 25rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-icon {
  display: block;
  font-size: 50rpx;
  margin-bottom: 12rpx;
}

.stat-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #07c160;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  color: #666;
  font-size: 24rpx;
}

.add-post-btn {
  position: fixed;
  bottom: 40rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07c160;
  border: none;
  color: white;
  font-size: 50rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.modal-content {
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  background: #f5f5f5;
  border: none;
  color: #999;
  font-size: 48rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 15rpx;
  color: #333;
  font-weight: 500;
  font-size: 28rpx;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  padding: 25rpx;
  border: 1rpx solid #e5e5e5;
  background: white;
  color: #333;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 200rpx;
  line-height: 1.6;
}

.file-upload {
  border: 2rpx dashed #e5e5e5;
  border-radius: 16rpx;
  padding: 50rpx;
  text-align: center;
  background: #fafafa;
}

.file-upload-icon {
  display: block;
  font-size: 70rpx;
  margin-bottom: 15rpx;
}

.file-upload-text {
  color: #999;
  font-size: 26rpx;
}

.preview-container {
  position: relative;
  margin-top: 20rpx;
}

.preview-image,
.preview-video {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
}

.remove-media {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.submit-btn {
  width: 100%;
  padding: 28rpx;
  background: #07c160;
  border: none;
  border-radius: 12rpx;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.post-view {
  max-width: 100%;
}

.post-view-date {
  color: #999;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.post-media-large {
  width: 100%;
  max-height: 600rpx;
  border-radius: 16rpx;
  margin-bottom: 25rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  overflow: hidden;
}

.post-image-large,
.post-video-large {
  width: 100%;
  max-height: 600rpx;
}

.post-emoji-large {
  font-size: 120rpx;
}

.post-full-text {
  line-height: 1.8;
  font-size: 28rpx;
  white-space: pre-wrap;
  color: #333;
}

.post-view-likes {
  margin-top: 30rpx;
  padding-top: 25rpx;
  border-top: 1rpx solid #f0f0f0;
  color: #07c160;
  font-weight: 600;
  font-size: 26rpx;
}
