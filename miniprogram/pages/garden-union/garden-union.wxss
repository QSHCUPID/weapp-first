/* 整体样式 */
page {
  background-color: #f5f7fa;
  height: 100vh;
  overflow: hidden;
}

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 固定头部区域 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transform: translateY(-100%);
  transition: transform 0.3s ease;
}

.fixed-header.show {
  transform: translateY(0);
}

/* 可滚动内容区域 */
.scrollable-content {
  flex: 1;
  height: 100%;
  background-color: #f5f7fa;
}

/* 顶部区域 */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.union-name {
  color: white;
  font-size: 18px;
  font-weight: bold;
  letter-spacing: 1px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.input-btn {
  background-color: white;
  color: #667eea;
  border: none;
  border-radius: 18px;
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

/* 需要录入时的高亮样式 */
.input-btn.highlight {
  animation: pulse 1.5s ease-in-out infinite;
  background-color: #ffd700;
  color: #ff6b6b;
  font-weight: bold;
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 2px 6px rgba(0, 0, 0, 0.2);
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(255, 215, 0, 1), 0 4px 12px rgba(0, 0, 0, 0.3);
  }
}

.user-info {
  background-color: rgba(255,255,255,0.25);
  padding: 6px 12px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.user-info.clickable {
  background-color: rgba(255,255,255,0.35);
  cursor: pointer;
}

.user-game-name {
  color: white;
  font-size: 13px;
  margin-right: 4px;
  font-weight: 500;
}

.select-arrow {
  color: white;
  font-size: 9px;
  opacity: 0.9;
}

/* 搜索区域 */
.search-section {
  padding: 15px;
  background-color: white;
  border-bottom: 1px solid #f0f0f0;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background-color: #f5f7fa;
  border-radius: 20px;
  padding: 12px 40px 12px 15px;
  font-size: 14px;
}

.search-icon {
  position: absolute;
  right: 15px;
  font-size: 16px;
}

/* 过滤区域 */
.filter-section {
  background-color: white;
  padding: 15px;
}

.filter-mode-row {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
}

.filter-mode-btn {
  flex: 1;
  text-align: center;
  padding: 10px;
  border-radius: 8px;
  background-color: #f5f7fa;
  color: #666;
  font-size: 14px;
  transition: all 0.3s;
}

.filter-mode-btn.active {
  background-color: #667eea;
  color: white;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-row.view-tags-row {
  display: block;
  margin-bottom: 12px;
}

.filter-item {
  display: flex;
  align-items: center;
  flex: 1;
}

.filter-item.view-filter-tags {
  flex-wrap: wrap;
}

.filter-label {
  font-size: 14px;
  color: #666;
  margin-right: 8px;
}

/* 排序控制样式 */
.sort-control-wrapper {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.sort-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f7fa;
  padding: 6px 8px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s;
  border: 1px solid transparent;
  min-width: 32px;
}

.sort-icon-btn:active {
  background-color: #e8eaf0;
  border-color: #667eea;
}

.sort-text-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f7fa;
  padding: 6px 10px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s;
  border: 1px solid transparent;
  white-space: nowrap;
}

.sort-text-btn:active {
  background-color: #e8eaf0;
  border-color: #667eea;
}

.sort-icon {
  font-size: 13px;
  color: #667eea;
  font-weight: bold;
  line-height: 1;
}

.sort-text {
  font-size: 11px;
  color: #666;
  white-space: nowrap;
}

.picker {
  background-color: #f5f7fa;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 14px;
  color: #333;
}

/* 视图过滤标签组 */
.tag-group {
  display: flex;
  flex-wrap: nowrap;
  gap: 6px;
  overflow-x: auto;
}

.filter-tag {
  background-color: #f5f7fa;
  color: #666;
  padding: 5px 10px;
  border-radius: 14px;
  font-size: 12px;
  transition: all 0.3s;
  cursor: pointer;
  border: 1px solid transparent;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-tag.active {
  background-color: #667eea;
  color: white;
  border-color: #667eea;
  box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
}

/* 快速竞赛分标签 */
.quick-score-tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 4px;
  margin-top: 0;
  padding-left: 0;
}

.score-tag {
  background-color: #fff3e0;
  color: #f57c00;
  padding: 3px 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 500;
  transition: all 0.3s;
  cursor: pointer;
  border: 1px solid #ffe0b2;
  white-space: nowrap;
  flex-shrink: 0;
  text-align: center;
  box-shadow: 0 1px 2px rgba(245, 124, 0, 0.08);
}

.score-tag:active {
  transform: scale(0.95);
}

.score-tag.active {
  background-color: #ff9800;
  color: white;
  border-color: #ff9800;
  box-shadow: 0 2px 5px rgba(255, 152, 0, 0.3);
}

.score-input {
  width: 60px;
  background-color: #f5f7fa;
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 14px;
  text-align: center;
}

.score-separator {
  margin: 0 8px;
  color: #999;
}

.apply-btn {
  background-color: #667eea;
  color: white;
  border: none;
  border-radius: 4px;
  padding: 6px 12px;
  font-size: 12px;
  margin-left: 8px;
}

/* 统计信息 */
.stats-section {
  padding: 12px 15px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.stats-text {
  color: white;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.5px;
}

.stats-separator {
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
  font-weight: 300;
}

/* 花朵列表 */
.flower-list {
  padding: 15px 15px 100px 15px;
}

.flower-item {
  background-color: white;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.flower-image {
  width: 70px;
  height: 70px;
  border-radius: 8px;
  margin-right: 12px;
  background-color: #f5f7fa;
}

.flower-info {
  flex: 1;
}

.flower-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.flower-name {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-right: 8px;
}

.flower-type {
  background-color: #e8f5e9;
  color: #2e7d32;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
}

.flower-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.flower-score {
  font-size: 13px;
  color: #ff9800;
  margin-right: 12px;
}

.flower-owner-count {
  font-size: 13px;
  color: #666;
}

.flower-owners {
  width: 100%;
  height: 28px;
  white-space: nowrap;
}

.owner-tags-container {
  display: inline-flex;
  gap: 6px;
  padding-right: 10px;
}

.owner-tag {
  background-color: #f3e5f5;
  color: #7b1fa2;
  padding: 3px 8px;
  border-radius: 10px;
  font-size: 11px;
  white-space: nowrap;
  flex-shrink: 0;
}

.flower-actions {
  display: flex;
  flex-direction: row;
  gap: 4px;
  margin-left: 8px;
}

.action-btn {
  width: 24px !important;
  height: 24px !important;
  min-width: 24px !important;
  min-height: 24px !important;
  max-width: 24px !important;
  max-height: 24px !important;
  border: none;
  border-radius: 50% !important;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 12px;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1;
  background-color: #e0e0e0;
}

.action-btn.active {
  background-color: #4caf50;
  box-shadow: 0 1px 4px rgba(76, 175, 80, 0.3);
}

.grow-btn {
  font-size: 14px;
}

.grow-btn.active {
  background-color: #ff9800;
  box-shadow: 0 1px 4px rgba(255, 152, 0, 0.3);
}

.owned-btn {
  font-size: 11px;
}

.owned-btn.active {
  background-color: #4caf50;
  box-shadow: 0 1px 4px rgba(76, 175, 80, 0.3);
}

.delete-btn {
  width: 24px !important;
  height: 24px !important;
  min-width: 24px !important;
  min-height: 24px !important;
  max-width: 24px !important;
  max-height: 24px !important;
  border: none;
  border-radius: 50% !important;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 12px;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1;
  background-color: #ff5252;
  color: white;
  box-shadow: 0 1px 4px rgba(255, 82, 82, 0.3);
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40px 0;
  font-size: 14px;
}

/* 加载状态提示 */
.loading-tip {
  text-align: center;
  color: #999;
  padding: 20px 0;
  font-size: 14px;
}

.loading-tip text {
  display: inline-block;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0%, 100% {
    opacity: 0.3;
  }
  50% {
    opacity: 1;
  }
}

/* 没有更多数据提示 */
.no-more-tip {
  text-align: center;
  color: #999;
  padding: 20px 0;
  font-size: 13px;
  border-top: 1px solid #f0f0f0;
  margin-top: 10px;
}

/* 底部添加按钮 */
.add-btn-area {
  position: fixed;
  bottom: 20px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 30px;
  padding: 12px 30px;
  display: flex;
  align-items: center;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.add-icon {
  font-size: 24px;
  margin-right: 8px;
  line-height: 1;
}

.add-text {
  font-size: 16px;
  font-weight: bold;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  border-radius: 16px;
  padding: 24px;
  width: 80%;
  max-width: 400px;
}

.add-flower-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20px;
}

.modal-input {
  width: 100%;
  background-color: #f5f7fa;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
  margin-bottom: 20px;
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  background-color: #f5f7fa;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
}

.image-upload {
  width: 100px;
  height: 100px;
  background-color: #f5f7fa;
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 32px;
  margin-bottom: 4px;
}

.upload-text {
  font-size: 12px;
  color: #999;
}

.modal-buttons {
  display: flex;
  gap: 12px;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
}

.modal-btn.cancel {
  background-color: #e0e0e0;
  color: #666;
}

.modal-btn.confirm {
  background-color: #667eea;
  color: white;
}

/* 用户选择器弹窗 */
.user-picker-modal {
  max-height: 70vh;
}

.user-list {
  max-height: 40vh;
  margin-bottom: 16px;
}

.user-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-item.selected {
  background-color: #e8f5e9;
}

.user-item-name {
  font-size: 15px;
  color: #333;
}

.user-item-check {
  color: #4caf50;
  font-size: 18px;
  font-weight: bold;
}

/* 编辑按钮 */
.edit-btn {
  background-color: #2196f3 !important;
  color: white !important;
  box-shadow: 0 1px 4px rgba(33, 150, 243, 0.3);
}

/* 编辑花朵弹窗 */
.edit-flower-modal {
  max-height: 85vh;
  overflow-y: auto;
  width: 85%;
  max-width: 450px;
}

.edit-section {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid #f0f0f0;
}

.edit-section:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.section-title {
  font-size: 15px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 3px;
  height: 14px;
  background-color: #667eea;
  margin-right: 8px;
  border-radius: 2px;
}

/* 拥有者列表 */
.owner-list {
  max-height: 280px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  margin-top: 8px;
  background-color: #fafafa;
}

.owner-item {
  display: flex;
  align-items: center;
  padding: 12px 14px;
  border-bottom: 1px solid #f0f0f0;
  transition: all 0.2s;
  cursor: pointer;
}

.owner-item:last-child {
  border-bottom: none;
}

.owner-item:active {
  background-color: #f5f5f5;
}

.owner-item.checked {
  background-color: #e8f5e9;
}

.owner-item.checked:active {
  background-color: #dcedc8;
}

.owner-checkbox {
  width: 22px;
  height: 22px;
  border: 2px solid #bdbdbd;
  border-radius: 4px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 10px;
  transition: all 0.2s;
  flex-shrink: 0;
  background-color: white;
}

.owner-item.checked .owner-checkbox {
  border-color: #4caf50;
  background-color: #4caf50;
}

.check-icon {
  color: white;
  font-size: 14px;
  font-weight: bold;
  line-height: 1;
}

.owner-name {
  font-size: 14px;
  color: #333;
  flex: 1;
}

.owner-item.checked .owner-name {
  color: #2e7d32;
  font-weight: 500;
}
